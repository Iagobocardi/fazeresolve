# Aplicação local
PORT=3000
MONGODB_URI=mongodb://localhost:27017/fazeresolve
JWT_SECRET=troque-esta-chave-em-producao
SESSION_SECRET=troque-esta-chave-em-producao
# Exatamente 32 caracteres; use uma chave secreta diferente em produção.
CRYPTO_SECRET_KEY=12345678901234567890123456789012
CRYPTO_IV=1234567890123456
FRONTEND_URL=http://localhost:3001

# Mantenha false em ambiente de demonstração: evita chamadas a serviços externos.
ENABLE_JOBS=false
SEED_DEMO_DATA=false
